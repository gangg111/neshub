<?xml version="1.0" encoding="utf-8"?>
<!-- Game screen fills the window; the touch pad is a translucent overlay on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gbc_screen_bg">

    <FrameLayout
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gbc_screen_bg">

        <SurfaceView
            android:id="@+id/emulator_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/emulator_surface_desc" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
